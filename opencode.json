{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@warp-dot-dev/opencode-warp"],
  "mcp": {
    "ms365": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@softeria/ms-365-mcp-server",
        "--preset",
        "outlook",
        "--read-only"
      ],
      "enabled": true,
      "environment": {
        "MS365_MCP_TENANT_ID": "consumers"
      }
    }
  }
}
