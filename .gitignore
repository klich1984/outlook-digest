# Dependencies
node_modules/

# Local env files (the .env.example template IS tracked)
.env
.env.*
!.env.example

# Local MSAL cache used during interactive login
.cache/

# Local-only state files used during local development runs.
# state/reported-ids.json IS tracked because the GitHub Actions workflow
# commits it after each successful run with [skip ci].
state/*.local.json

# Backup of package-lock.json
package-lock.json.bak

# Coverage reports (generated by `npm run test:coverage`)
coverage/

# Local-only dry-run artifacts (generated by `npm run dev:dry`)
.local/

# MSAL and Gmail cache files used during interactive login flows.
# These contain secrets — never commit them. Regenerate from
# scripts/get-msal-token-cache.mjs or scripts/get-gmail-refresh-token.mjs.
*-client_secret_*.json
client_secret_*.json
msal-cache.json
*msal*.cache.json

# OpenCode internal skill registry cache
.atl/

# Editor / OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/
*.code-workspace
