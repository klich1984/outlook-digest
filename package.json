{
  "name": "mail-digest",
  "version": "0.1.0",
  "description": "Weekly digest of unread Hotmail messages delivered to a Gmail inbox",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:once": "node scripts/index.mjs",
    "dev:dry": "node scripts/index.mjs --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@azure/msal-node": "^3.5.0",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "open": "^11.0.0",
    "vitest": "^4.1.9"
  }
}
