# Mail Digest — variables de entorno
#
# Copia este archivo a `.env` y completa cada valor. NO commitees `.env`.
# Las variables que empiezan con `GMAIL_*` se usan también para enviar el
# correo de error cuando el pipeline falla.

# Dirección de la cuenta Hotmail que se va a consultar (la cuenta personal,
# nunca escrita en código).
HOTMAIL_ACCOUNT_ADDRESS=

# Cache de tokens MSAL serializado como JSON string. Se genera ejecutando
# el flujo de login de Microsoft y exportando el archivo de cache.
MSAL_TOKEN_CACHE_JSON=

# Credenciales OAuth2 de Gmail para enviar el reporte (Desktop application
# en Google Cloud Console, scope gmail.send con access_type=offline).
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# Dirección Gmail donde se entrega el reporte semanal. Es la misma a la que
# llega el correo de error si el pipeline falla.
GMAIL_DESTINATION_ADDRESS=
